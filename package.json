{
  "name": "keysnitch",
  "version": "0.1.4",
  "description": "Find leaked API keys, tokens and passwords in any text. Zero dependencies, linear time rules, safe to run on untrusted input.",
  "keywords": [
    "secrets",
    "secret-scanning",
    "api-keys",
    "credentials",
    "leak-detection",
    "security",
    "redaction",
    "gitleaks"
  ],
  "license": "MIT",
  "author": "Roman Kolpachev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roman-kolpachev/keysnitch.git"
  },
  "bugs": "https://github.com/roman-kolpachev/keysnitch/issues",
  "homepage": "https://simplify-software.org/keysnitch",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=2 \"test/**/*.test.ts\"",
    "coverage": "node --test --test-concurrency=2 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
    "build": "node tools/clean.ts && tsc -p tsconfig.build.json && node tools/fix-declarations.ts",
    "bench": "node bench/regex.ts",
    "docs:rules": "node tools/rules-doc.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run coverage && npm run build && npm run check:consumer && npm pack --dry-run --ignore-scripts",
    "check:consumer": "tsc -p test/consumer/tsconfig.bundler.json && tsc -p test/consumer/tsconfig.nodenext.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
